# PLANTILLA: copiar como backend/.env y completar. Este archivo sí se sube a git, sin datos reales.

# Correo (SMTP). Con Gmail: SMTP_USER = la cuenta de Gmail, SMTP_PASS = una "contraseña de aplicación"
# de 16 letras (https://myaccount.google.com/apppasswords), NO la contraseña normal de la cuenta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Dominios del sitio que pueden llamar a la API (separar con coma). Agregue el dominio real al publicar,
# por ejemplo: http://localhost:4200,https://www.su-dominio.com
ALLOWED_ORIGINS=http://localhost:4200
PORT=3000

# Supabase: mismos valores PÚBLICOS que el .env del frontend. Sirven para validar la sesión del administrador.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

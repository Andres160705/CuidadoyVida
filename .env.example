# Copiar como .env y completar. Solo valores PÚBLICOS: terminan dentro del JavaScript del navegador.
# Use la clave "publishable" (sb_publishable_...) o "anon". NUNCA la "secret" ni la "service_role".
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
API_URL=/api
API_URL_DEV=http://localhost:3000/api

# Dominio público del sitio, solo con https y sin barra final (ej. https://www.su-dominio.com).
# Se usa al compilar para og:image, robots.txt y sitemap.xml. Es opcional mientras no haya dominio.
SITE_URL=

# Captcha del formulario (Cloudflare Turnstile → https://dash.cloudflare.com → Turnstile). Clave PÚBLICA (site key).
# Vacía = formulario sin captcha (útil en local). Clave de prueba que siempre aprueba: 1x00000000000000000000AA
TURNSTILE_SITE_KEY=

# ── SOLO en Vercel (Settings → Environment Variables), NUNCA en este archivo ni en el frontend ──
# TURNSTILE_SECRET_KEY       clave secreta de Turnstile, la usa api/solicitud.js
# SUPABASE_SERVICE_ROLE_KEY  clave secreta de Supabase (sb_secret_…), la usa api/solicitud.js
